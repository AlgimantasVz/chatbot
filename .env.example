# Copy this file to .env and fill it in:  cp .env.example .env
# .env is ignored by git, so your keys never get published.

# Your Cloudflare Access login email: gets all tools and the memory panel
OWNER_EMAIL=you@example.com

# Local model served by Ollama
OLLAMA_MODEL=qwen3:14b

# Web search: free API key from your ollama.com account (leave empty to disable)
OLLAMA_API_KEY=

# Cloudflare Access token verification (recommended when using the tunnel)
# Team domain: shown on the Cloudflare Access login page, e.g. myteam.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag: in your Access application's settings
CF_ACCESS_AUD=

# Public hostname of the tunnel (requests for other hostnames are refused)
PUBLIC_HOST=agent.example.com

# Optional
# PORT=3000
# NUM_CTX=16384
